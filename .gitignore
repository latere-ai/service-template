# The lint configuration is generated by `make lint-config` in both modules,
# from the shared template in latere.ai/x/ci-gate. A committed copy makes
# drift detectable; regenerating makes it impossible. The generated reference
# service is output, so its copy is ignored too.
.golangci.yml
skeleton/.golangci.yml
example/.golangci.yml
