# Environment configuration.
#
# Copy this file to .env and edit the values. Every variable below is read once
# at start-up. Precedence, highest first: a command-line flag, this variable,
# the file named by <NAME>_FILE, then the default shown here.
#
# Generated from the configuration struct. Run "make env-example" after adding
# or changing a field; "make env-example-check" proves the committed copy is
# current.

# Name reported in telemetry and logs.
# flag: -service-name
SERVICE_NAME=service

# Deployment environment: development, staging, or production.
# flag: -environment
ENVIRONMENT=development

# HTTP listen address as host:port.
# flag: -addr
ADDR=:8080

# Minimum log level: debug, info, warn, or error.
# flag: -log-level
LOG_LEVEL=info

# Log handler: json or text.
# flag: -log-format
LOG_FORMAT=json

# Deadline for reading request headers.
# flag: -http-read-header-timeout
HTTP_READ_HEADER_TIMEOUT=5s

# Deadline for reading the whole request.
# flag: -http-read-timeout
HTTP_READ_TIMEOUT=30s

# Deadline for writing the response.
# flag: -http-write-timeout
HTTP_WRITE_TIMEOUT=30s

# Idle keep-alive timeout.
# flag: -http-idle-timeout
HTTP_IDLE_TIMEOUT=120s

# Wait after SIGTERM before refusing new connections.
# flag: -drain-delay
DRAIN_DELAY=5s

# Time in-flight requests may finish after the listener stops.
# flag: -grace-period
GRACE_PERIOD=30s

# Time one component has to stop before it is abandoned.
# flag: -stop-timeout
STOP_TIMEOUT=15s

# Deadline for one readiness check.
# flag: -ready-check-timeout
READY_CHECK_TIMEOUT=2s

# PostgreSQL connection string. Empty disables the database.
# flag: -database-url
# secret: mount it as a file and set DATABASE_URL_FILE instead.
# optional: unset leaves the feature off.
DATABASE_URL=

# OTLP collector base URL. Empty disables telemetry export.
# flag: -otel-exporter-otlp-endpoint
# optional: unset leaves the feature off.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTLP headers as comma-separated key=value pairs.
# flag: -otel-exporter-otlp-headers
# secret: mount it as a file and set OTEL_EXPORTER_OTLP_HEADERS_FILE instead.
# optional: unset leaves the feature off.
OTEL_EXPORTER_OTLP_HEADERS=

# Head trace sampling ratio between 0 and 1.
# flag: -otel-traces-sample-ratio
OTEL_TRACES_SAMPLE_RATIO=1.0
