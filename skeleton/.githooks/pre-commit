#!/bin/sh
# pre-commit: the staged Go files are gofmt-formatted, group their imports
# the way the linter wants, carry the license notice, build no outbound HTTP
# client without a trace, and hold no code the standard library already
# covers. The checks live in lateregate, pinned in go.mod and configured in
# .lateregate.yaml; this file only calls it, so the hook and CI never disagree.
#
# It runs no linter and no test: golangci-lint takes a machine-wide lock and
# the suite takes minutes, and a hook that blocks a commit gets disabled. The
# pre-push lints the packages a push changes, and CI runs the whole bar.
#
# Install with: make hooks
exec go tool lateregate hook
